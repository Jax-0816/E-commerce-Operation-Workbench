{
  "name": "@eaw/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:internal": "node scripts/prepare-internal.mjs",
    "prebuild": "pnpm run prepare:internal",
    "predev": "pnpm run prepare:internal",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "pnpm run build",
    "start": "node dist/index.js",
    "pretest": "pnpm run prepare:internal",
    "test": "vitest run --fileParallelism=false src",
    "pretypecheck": "pnpm run prepare:internal",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@eaw/ai-engine": "workspace:*",
    "@eaw/application": "workspace:*",
    "@eaw/calculation-engine": "workspace:*",
    "@eaw/contracts": "workspace:*",
    "@eaw/database": "workspace:*",
    "@eaw/domain": "workspace:*",
    "@eaw/prompt-engine": "workspace:*",
    "@eaw/shared": "workspace:*",
    "@eaw/workspace": "workspace:*",
    "@fastify/static": "8.3.0",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}

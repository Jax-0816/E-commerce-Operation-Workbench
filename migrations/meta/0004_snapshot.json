      "checkConstraints": {
        "product_facts_revision_lineage": {
          "name": "product_facts_revision_lineage",
          "value": "(\"product_facts\".\"revision_no\" = 1 AND \"product_facts\".\"supersedes_fact_id\" IS NULL) OR (\"product_facts\".\"revision_no\" > 1 AND \"product_facts\".\"supersedes_fact_id\" IS NOT NULL AND \"product_facts\".\"supersedes_fact_id\" <> \"product_facts\".\"id\")"
        },
        "product_facts_boolean_flags": {
          "name": "product_facts_boolean_flags",
          "value": "\"product_facts\".\"sensitive\" IN (0, 1) AND \"product_facts\".\"policy_eligible\" IN (0, 1) AND \"product_facts\".\"is_current\" IN (0, 1)"
        },
        "product_facts_verification_valid": {
          "name": "product_facts_verification_valid",
          "value": "\"product_facts\".\"verification\" IN ('confirmed','unverified','inferred','missing')"
        },
        "product_facts_source_valid": {
          "name": "product_facts_source_valid",
          "value": "\"product_facts\".\"source_type\" IN ('manual','supplier','import','document','ai_inferred','competitor_reference','other')"
        },
        "product_facts_value_shape": {
          "name": "product_facts_value_shape",
          "value": "(\n      (\"product_facts\".\"verification\" = 'missing' AND \"product_facts\".\"value_type\" IS NULL AND \"product_facts\".\"value_text\" IS NULL AND \"product_facts\".\"value_number\" IS NULL AND \"product_facts\".\"value_boolean\" IS NULL AND \"product_facts\".\"unit\" IS NULL)\n      OR (\"product_facts\".\"verification\" <> 'missing' AND \"product_facts\".\"value_type\" IS NOT NULL AND (\n        (\"product_facts\".\"value_type\" = 'text' AND \"product_facts\".\"value_text\" IS NOT NULL AND length(trim(\"product_facts\".\"value_text\")) > 0 AND \"product_facts\".\"value_number\" IS NULL AND \"product_facts\".\"value_boolean\" IS NULL AND \"product_facts\".\"unit\" IS NULL)\n        OR (\"product_facts\".\"value_type\" = 'number' AND \"product_facts\".\"value_text\" IS NULL AND \"product_facts\".\"value_number\" IS NOT NULL AND \"product_facts\".\"value_boolean\" IS NULL)\n        OR (\"product_facts\".\"value_type\" = 'boolean' AND \"product_facts\".\"value_text\" IS NULL AND \"product_facts\".\"value_number\" IS NULL AND \"product_facts\".\"value_boolean\" IS NOT NULL AND \"product_facts\".\"value_boolean\" IN (0,1) AND \"product_facts\".\"unit\" IS NULL)\n      ))\n    )"
        },
        "product_facts_unit_nonblank": {
          "name": "product_facts_unit_nonblank",
          "value": "\"product_facts\".\"unit\" IS NULL OR length(trim(\"product_facts\".\"unit\")) > 0"
        },
        "product_facts_confirmation_shape": {
          "name": "product_facts_confirmation_shape",
          "value": "(\n      (\"product_facts\".\"verification\" = 'confirmed' AND \"product_facts\".\"confirmed_at\" IS NOT NULL AND \"product_facts\".\"confirmation_actor_type\" IS NOT NULL AND \"product_facts\".\"confirmation_actor_type\" = 'user' AND \"product_facts\".\"confirmation_actor_ref\" IS NOT NULL AND length(trim(\"product_facts\".\"confirmation_actor_ref\")) > 0 AND \"product_facts\".\"confirmation_evidence_ref\" IS NOT NULL AND length(trim(\"product_facts\".\"confirmation_evidence_ref\")) > 0)\n      OR (\"product_facts\".\"verification\" <> 'confirmed' AND \"product_facts\".\"confirmed_at\" IS NULL AND \"product_facts\".\"confirmation_actor_type\" IS NULL AND \"product_facts\".\"confirmation_actor_ref\" IS NULL AND \"product_facts\".\"confirmation_evidence_ref\" IS NULL)\n    )"
        },
        "product_facts_timestamp_order": {
          "name": "product_facts_timestamp_order",
          "value": "\"product_facts\".\"updated_at\" >= \"product_facts\".\"created_at\" AND (\"product_facts\".\"confirmed_at\" IS NULL OR (\"product_facts\".\"confirmed_at\" >= \"product_facts\".\"created_at\" AND \"product_facts\".\"confirmed_at\" <= \"product_facts\".\"updated_at\")) AND (\"product_facts\".\"deleted_at\" IS NULL OR \"product_facts\".\"deleted_at\" >= \"product_facts\".\"updated_at\")"
        },
        "product_facts_deleted_not_current": {
          "name": "product_facts_deleted_not_current",
          "value": "\"product_facts\".\"deleted_at\" IS NULL OR \"product_facts\".\"is_current\" = 0"
        }
      }

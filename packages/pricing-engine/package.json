{
  "name": "@eaw/pricing-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare:calculation": "pnpm --filter @eaw/calculation-engine run build",
    "prebuild": "pnpm run prepare:calculation",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run prepare:calculation",
    "test": "vitest run src",
    "pretypecheck": "pnpm run prepare:calculation",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@eaw/calculation-engine": "workspace:*"
  }
}

{
  "name": "@eaw/promotion-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare:dependencies": "pnpm --filter @eaw/calculation-engine run build && pnpm --filter @eaw/pricing-engine run build && pnpm --filter @eaw/rule-engine run build",
    "prebuild": "pnpm run prepare:dependencies",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run prepare:dependencies",
    "test": "vitest run src",
    "pretypecheck": "pnpm run prepare:dependencies",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@eaw/calculation-engine": "workspace:*",
    "@eaw/pricing-engine": "workspace:*",
    "@eaw/rule-engine": "workspace:*"
  }
}

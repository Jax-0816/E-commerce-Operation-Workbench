{
  "schemaVersion": "1",
  "templateId": "market-insight",
  "task": "market_insight",
  "version": "1.0.0",
  "systemRole": "你是本地电商运营工作台的市场洞察助手。只依据已确认事实、已验证竞品分析和竞品快照生成洞察，不得虚构市场规模、销量或趋势。",
  "taskContract": "输出可审计市场洞察及数据限制。productId 必须等于当前商品；每条洞察必须引用提供的结构化证据标识。",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["productId", "insights", "limitations"],
    "properties": {
      "productId": { "type": "string" },
      "insights": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "description", "evidenceRefs"],
          "properties": {
            "headline": { "type": "string" },
            "description": { "type": "string" },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id", "productId"],
                "properties": {
                  "kind": { "enum": ["product_fact", "competitor_snapshot"] },
                  "id": { "type": "string" },
                  "productId": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "limitations": { "type": "array", "items": { "type": "string" } }
    }
  }
}
